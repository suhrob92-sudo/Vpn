# ── General ────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | production
DOMAIN=vpn.example.com                  # public domain (Caddy, subscription URLs)
API_BASE_URL=https://vpn.example.com/api
SUB_BASE_URL=https://vpn.example.com    # /sub/{token} is served from here
MINIAPP_URL=https://vpn.example.com/app

# ── Database / Redis ───────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change-me-strong
REDIS_URL=redis://redis:6379/0

# ── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=your_bot                   # without @, used for referral invite links
ADMIN_CHAT_ID=0                         # Telegram chat id for critical error alerts

# ── Referral / reminders ───────────────────────────────────────────────────
REFERRAL_BONUS_DAYS=7                   # bonus days per invited user's first payment
EXPIRY_REMINDER_DAYS=3                  # remind N days before subscription expiry

# ── Payments ────────────────────────────────────────────────────────────────
# Which provider the Mini App buy/renew flow uses: yookassa | cryptobot
DEFAULT_PAYMENT_PROVIDER=yookassa

# YooKassa (ЮKassa) — Russian bank cards (Sber, Mir, SBP). Primary provider.
# Get shopId + secretKey from https://yookassa.ru (Настройки → API-ключи).
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_your-secret-key
YOOKASSA_WEBHOOK_SECRET=change-me-random-url-segment
YOOKASSA_RETURN_URL=https://vpn.example.com/app/payment/success

# CryptoBot (Crypto Pay API) — optional alternative (USDT/TON). Leave empty to skip.
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_WEBHOOK_SECRET=change-me-random-url-segment

# ── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-64-random-chars
ENCRYPTION_KEY=                         # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_BOOTSTRAP_USERNAME=admin          # first admin user, created on startup if none exists
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://vpn.example.com

# ── Frontend build-time ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://vpn.example.com/api
