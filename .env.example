# ── General ────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | production
DOMAIN=vpn.example.com                  # public domain (Caddy, subscription URLs)
API_BASE_URL=https://vpn.example.com/api
SUB_BASE_URL=https://vpn.example.com    # /sub/{token} is served from here
MINIAPP_URL=https://vpn.example.com/app

# ── Database / Redis ───────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change-me-strong
REDIS_URL=redis://redis:6379/0

# ── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_CHAT_ID=0                         # Telegram chat id for critical error alerts

# ── Payments: CryptoBot (Crypto Pay API) ───────────────────────────────────
CRYPTOBOT_API_TOKEN=12345:AAyour-crypto-pay-token
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_WEBHOOK_SECRET=change-me-random-url-segment

# ── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-64-random-chars
ENCRYPTION_KEY=                         # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_BOOTSTRAP_USERNAME=admin          # first admin user, created on startup if none exists
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://vpn.example.com

# ── Frontend build-time ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://vpn.example.com/api
